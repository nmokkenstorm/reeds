<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.mokkenstorm.reeds</string>
  <key>ProgramArguments</key>
  <array>
    <string>@INSTALL@/reeds-run</string>
    <string>run</string>
  </array>
  <key>WorkingDirectory</key>
  <string>@HOME@</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>@PATH@</string>
    <key>HOME</key>
    <string>@HOME@</string>
    <key>REEDS_CONFIG</key>
    <string>@HOME@/.config/reeds/config.toml</string>
    <key>REEDS_LOG</key>
    <string>@HOME@/Library/Logs/reeds.log</string>
    <key>REEDS_DB</key>
    <string>@DB@</string>
  </dict>
  <key>KeepAlive</key>
  <true/>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>@HOME@/Library/Logs/reeds.log</string>
  <key>StandardErrorPath</key>
  <string>@HOME@/Library/Logs/reeds.log</string>
</dict>
</plist>
