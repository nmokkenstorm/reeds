#!/usr/bin/env bash
set -euo pipefail

# newsyslog renames the log but a daemon keeps writing to the old inode, so
# every line is appended through a fresh open instead of a held descriptor.
LOG="${REEDS_LOG:-$HOME/Library/Logs/reeds.log}"
HERE="$(cd "$(dirname "$0")" && pwd)"

exec > >(while IFS= read -r line || [ -n "$line" ]; do printf '%s\n' "$line" >>"$LOG"; done) 2>&1
exec "$HERE/entrypoint.sh" "${@:-run}"
