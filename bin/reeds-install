#!/usr/bin/env bash
set -euo pipefail

# Exports an erlang-shipment and points INSTALL at it with one rename, so a
# restart never compiles and never sees a half-copied tree.
INSTALL="${REEDS_INSTALL:-$HOME/.local/share/reeds/app}"
KEEP=2

repo="$(cd "$(dirname "$0")/.." && pwd)"
release="$INSTALL.$(date +%Y%m%d%H%M%S)"

mkdir -p "$(dirname "$INSTALL")"
(cd "$repo" && gleam export erlang-shipment)

cp -R "$repo/build/erlang-shipment" "$release.tmp"
cp "$repo/bin/reeds" "$release.tmp/reeds-cli"
cp "$repo/bin/reeds-watchdog" "$release.tmp/"
mv "$release.tmp" "$release"

[ -L "$INSTALL" ] || [ ! -e "$INSTALL" ] || mv "$INSTALL" "$INSTALL.legacy"
ln -s "$release" "$INSTALL.link"
mv -fh "$INSTALL.link" "$INSTALL"

# shellcheck disable=SC2012
ls -1dt "$INSTALL".[0-9]* | tail -n +$((KEEP + 1)) | xargs -I{} rm -rf {}
echo "reeds: installed $release -> $INSTALL"
