# Copy to ~/.config/reeds/backup.env (or point REEDS_BACKUP_CONFIG at it).
# Plain KEY=VALUE lines, parsed not sourced. Environment variables override.

# Required. Absolute directory that receives reeds-<date>.db.gz.
REEDS_BACKUP_DEST=/Volumes/LacDie/backups/reeds

# Optional. Skip silently (exit 0) unless this mount point is mounted.
# Empty means no mount check, for a local or always-on destination.
REEDS_BACKUP_REQUIRE_MOUNT=/Volumes/LacDie

# Optional. Defaults to the top-level db in config.toml, else <repo>/reeds.db.
# REEDS_DB=/absolute/path/reeds.db

# Optional. Refuse to write unless the mount has this VolumeUUID (guards
# against another disk mounted under the same name). Find it with:
#   diskutil info -plist /Volumes/LacDie | plutil -extract VolumeUUID raw -o - -
# REEDS_BACKUP_VOLUME_UUID=

# REEDS_BACKUP_KEEP_DAYS=30
# REEDS_BACKUP_PREFIX=reeds
